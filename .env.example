# Jal-Rakshak Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# ===== AIS Data Provider =====
# AISStream.io API key for live vessel tracking
# Get one at: https://aisstream.io/
AISSTREAM_API_KEY=your_aisstream_api_key_here

# ===== Mode Configuration =====
# Set to "demo" for offline demo mode, "live" for real API calls
APP_MODE=demo

# ===== SAR Configuration =====
# Default pixel resolution in meters (used when geospatial metadata unavailable)
DEFAULT_PIXEL_RESOLUTION_M=10.0

# ===== Ocean Data =====
# Reserved for future ocean data provider API keys
# OCEAN_DATA_API_KEY=

# ===== Notification =====
# Reserved for future notification provider credentials
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMS_API_KEY=

# ===== Logging =====
LOG_LEVEL=INFO
